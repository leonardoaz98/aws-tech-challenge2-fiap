# Copie este arquivo para .env e preencha com seus valores.
# O .env contem credenciais de projeto e NUNCA deve ser commitado.

# --- AWS ---
AWS_REGION=us-east-1

# Bucket do S3 que hospeda as camadas Bronze, Silver e Gold
S3_BUCKET=seu-bucket-datalake

# Banco do Glue Catalog consultado pelo Athena
ATHENA_DATABASE=tc2_gold

# Bucket de resultados das queries do Athena (precisa terminar com /)
ATHENA_S3_OUTPUT=s3://seu-bucket-athena-results/

# --- Base dos Dados ---
# A fonte publica e hospedada no BigQuery: e preciso um projeto GCP apenas
# para faturamento das queries de leitura, mesmo que o pipeline rode em AWS.
BD_BILLING_PROJECT=seu-project-id-gcp

# --- Migracao GCP -> AWS (apenas para scripts/migracao/) ---
# Nao usados pelo pipeline corrente.
GCP_PROJECT_ID=seu-project-id-gcp
BQ_DATASET_GOLD=gold
